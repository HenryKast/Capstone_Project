# Copy this file to `.env` in the repo root and fill in values locally.
# Never commit `.env` — it holds API keys and ESPN session cookies.

# Optional: CollegeFootballData API key for college production stats
# https://collegefootballdata.com/
CFBD_API_KEY=

# Optional: ESPN Fantasy private-league cookies (only needed to refresh
# raw ESPN pulls). Pre-built league CSVs under data/output/csv/ ship in-repo,
# so most users can skip these.
# Sign in at https://fantasy.espn.com , then copy from browser cookies:
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
